VITE_API_URL=http://localhost:8000
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live API model for the real-time voice check-in/call features.
# gemini-2.0-flash-exp (the old default) was retired in mid-2026 - this is
# its current replacement. If it's unavailable on your key/tier, try
# models/gemini-3.1-flash-live-preview instead.
VITE_GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
